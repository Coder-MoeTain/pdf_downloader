# Application environment: development | testing | production
APP_ENV=development

# Contact email used for polite API pools (Crossref, OpenAlex) and Unpaywall.
# Unpaywall requires a real email address.
CONTACT_EMAIL=you@example.com
UNPAYWALL_EMAIL=

# Optional provider API keys. Leave blank to skip that provider.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
IEEE_API_KEY=
NCBI_API_KEY=
NASA_ADS_TOKEN=

# Optional. Raises GitHub API rate limits for the Top projects page.
GITHUB_TOKEN=

# HTTP / download
MAX_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_REDIRECTS=5

# Bind address. Development default is localhost. Production should sit behind a reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8000

# Paper library. Production uses MySQL. Local/dev can leave MYSQL_HOST empty for SQLite.
# DATABASE_PATH=data/research.db is only used when MYSQL_HOST is empty.
# After switching to MySQL, copy the old files with:
#   ./venv/bin/python scripts/migrate_sqlite_to_mysql.py --replace --yes
#   (or: python3 scripts/migrate_sqlite_to_mysql.py --replace --yes)
DATABASE_PATH=data/research.db

# MySQL / MariaDB for the paper library AND settings/sources.
# Required in production. Example:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=cyber_admin
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=research_collector
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=research_collector
MYSQL_SOCKET=
SETTINGS_SQLITE_PATH=data/settings.db

# Google sign-in. Create an OAuth client in Google Cloud Console and add
# http://127.0.0.1:8000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Gmail addresses that can open Sources and Settings.
GOOGLE_ADMIN_EMAILS=

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Production: the hostname you type in the browser (comma-separated).
# Development ignores this and accepts any Host (LAN IP, PC name, tunnels).
# Example production: ALLOWED_HOSTS=research.example.com,localhost,127.0.0.1
ALLOWED_HOSTS=

# Reverse-proxy addresses allowed to set X-Forwarded-* headers. Never use * in production.
TRUSTED_PROXY_IPS=127.0.0.1

# Set true only when this process terminates TLS itself (not when Nginx/Cloudflare terminates TLS).
HTTPS_REDIRECT=false

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# LMS sync is off until you explicitly configure a sibling e-library path.
# Local MariaDB uses MYSQL_SOCKET (or auto-detected /run/mysqld/mysqld.sock).
# TCP to 127.0.0.1 often times out on this host — leave LMS_DB_HOST empty or use localhost.
LMS_SYNC_ENABLED=false
LMS_ROOT=
LMS_CATEGORY=Research Papers
LMS_DB_HOST=
LMS_DB_PORT=3306
LMS_DB_NAME=
LMS_DB_USER=
LMS_DB_PASSWORD=
