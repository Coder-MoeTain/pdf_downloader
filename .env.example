# Contact email used for polite API pools (Crossref, OpenAlex) and Unpaywall.
# Unpaywall requires a real email address.
CONTACT_EMAIL=you@example.com
UNPAYWALL_EMAIL=

# Optional provider API keys. Leave blank to skip that provider.
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
SPRINGER_API_KEY=
ELSEVIER_API_KEY=
IEEE_API_KEY=
NCBI_API_KEY=
NASA_ADS_TOKEN=

# HTTP / download
MAX_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_REDIRECTS=5

# Paper library (SQLite)
DATABASE_PATH=data/research.db

# Settings + academic sources (MySQL / MariaDB). Leave MYSQL_HOST empty to use SQLite fallback.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=research_collector
SETTINGS_SQLITE_PATH=data/settings.db

# Google sign-in. Create an OAuth client in Google Cloud Console and add
# http://127.0.0.1:8000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Gmail addresses that can open Sources and Settings.
GOOGLE_ADMIN_EMAILS=
# Random string used to sign login cookies.
SESSION_SECRET=

# Optional local admin for `python main.py seed-admin`. Defaults: admin@localhost / Admin@123
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Push downloaded open-access PDFs into the sibling e-library app.
# Cloud example: /var/www/pdf_downloader and /var/www/elibrary
LMS_SYNC_ENABLED=true
# Leave empty to auto-detect ../elibrary  (or set the absolute path)
LMS_ROOT=/var/www/elibrary
LMS_CATEGORY=Research Papers
# Leave empty to reuse DB_* from the LMS .env
LMS_DB_HOST=
LMS_DB_NAME=
LMS_DB_USER=
LMS_DB_PASSWORD=
